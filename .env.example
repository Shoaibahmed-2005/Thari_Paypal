# Copy to .env.local and fill in. Never commit .env.local.

# App
APP_URL=http://localhost:3000
SESSION_SECRET=

# Database (Neon)
DATABASE_URL=
DIRECT_URL=

# Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Gemini — check https://ai.google.dev/gemini-api/docs/models for current IDs
GEMINI_API_KEY=
# Verified against aistudio.google.com/docs on 2026-11-11.
# Sulafat is the voice the docs describe as "warm"; TTS returns 24kHz mono WAV.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Sulafat
AI_MODE=live

# PayPal (sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Business config
FX_INR_PER_USD=88
SHIPPING_USD=20
DEFAULT_COOP_COMMISSION_PCT=10

# Sandbox account emails (M3)
SANDBOX_BUYER_EMAIL=
SANDBOX_WEAVER_EMAIL=
SANDBOX_COOP_EMAIL=
# Buyer account password, shown to judges on /demo (BUILD_PLAN 9.1). Sandbox only.
SANDBOX_BUYER_PASSWORD=
